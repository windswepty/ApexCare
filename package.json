{
  "name": "apex-care",
  "productName": "APEX CARE",
  "private": true,
  "version": "1.0.2",
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:start": "electron .",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.apexcare.app",
    "productName": "APEX CARE",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "APEX CARE",
      "uninstallDisplayName": "APEX CARE 삭제",
      "runAfterFinish": true,
      "license": "public/license.txt"
    }
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lenis": "^1.3.26",
    "lucide-react": "^1.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "systeminformation": "^5.25.11"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0",
    "wait-on": "^8.0.3"
  }
}
